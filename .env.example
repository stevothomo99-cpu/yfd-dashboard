# YFD Dashboard environment variables.
# Copy to .env.local for local development. Set the live values in
# Vercel → Project Settings → Environment Variables for staging/prod.
# Never commit real secrets to Git.

# ─── Auth ──────────────────────────────────────────────────────────
# Random 32+ char string. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Supabase credentials for user management
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployment. Required in production; auto-detected on Vercel.
# AUTH_URL=https://yfd-dashboard.vercel.app

# ─── XPM / Xero OAuth ─────────────────────────────────────────────
XPM_CLIENT_ID=
XPM_CLIENT_SECRET=
XPM_REFRESH_TOKEN=
XPM_TENANT_ID=
# v3.0 always returns XML regardless of Accept header — only v3.1 supports
# JSON, which lib/xpm.ts relies on. Same OAuth scopes work on both.
XPM_BASE_URL=https://api.xero.com/practicemanager/3.1
# 32-byte key (base64) used to encrypt the Xero access/refresh tokens at
# rest before they're cached. Generate with: openssl rand -base64 32
XPM_TOKEN_ENCRYPTION_KEY=

# ─── Xero Accounting (revenue by client) ───────────────────────────
# Separate OAuth connection from XPM above -- connects to YFD's own Xero
# Accounting organisation (where invoices to clients are issued), not the
# Practice Manager tenant. Reuses XPM_TOKEN_ENCRYPTION_KEY to encrypt its
# tokens at rest (see lib/xeroAccounting.ts) -- no separate key needed.
XERO_ACCOUNTING_CLIENT_ID=
XERO_ACCOUNTING_CLIENT_SECRET=
XERO_ACCOUNTING_REFRESH_TOKEN=
XERO_ACCOUNTING_TENANT_ID=

# ─── Resend — outbound (transactional notification emails) ─────────
# This account's API key is also entered as Supabase Auth's SMTP password
# (see Supabase → Authentication → Emails → SMTP Settings) for its own
# emails (password reset, etc.) -- separate wiring, same key, see
# lib/resend.ts. Currently the SiteMargin Resend account/domain (YFD's own
# domain has no verified sending domain on the free plan).
RESEND_API_KEY=
# Sender address for outbound notification emails, e.g.
# "YFD Dashboard <noreply@sitemargin.com.au>" -- must be on a domain
# verified in the RESEND_API_KEY account above.
RESEND_FROM_EMAIL=

# ─── Resend — inbound (email-to-todo) ───────────────────────────────
# A THIRD, separate Resend account/domain from RESEND_API_KEY above --
# free-plan Resend accounts only support one verified domain each, and
# inbound needs its own subdomain so its MX records don't clobber
# yourfinancedept.com.au's real mail (Microsoft 365). Set up as:
# todo@dashboard.yourfinancedept.com.au, with Resend Inbound (MX records)
# enabled on the dashboard.yourfinancedept.com.au subdomain only.
# This account's own API key -- NOT the same value as RESEND_API_KEY above.
RESEND_INBOUND_API_KEY=
# Signing secret for the inbound webhook (this account's Resend dashboard →
# Webhooks → the endpoint pointed at /api/email/inbound), verified via
# svix headers.
RESEND_WEBHOOK_SECRET=
# The shared address staff forward emails to, to create a To-Do item (see
# app/api/email/inbound/route.ts) -- must be on the domain/subdomain with
# Resend's Inbound feature enabled above.
TODO_INBOUND_EMAIL=

# ─── Karbon ───────────────────────────────────────────────────────
KARBON_API_KEY=
# Optional — only needed for Karbon v3 (sends an extra AccessKey header).
KARBON_ACCESS_KEY=
KARBON_BASE_URL=https://api.karbonhq.com/v3
# Karbon v3 has no separate "BAS" resource — /api/karbon/work filters
# /WorkItems by WorkType. Set this to the exact label configured in
# Karbon → Settings → Work Types (e.g. "BAS"). Leave unset to return all
# WorkItems unfiltered.
KARBON_BAS_WORK_TYPE=

# ─── Redis (auto-populated when a Redis integration is attached in Vercel's
# Storage tab — e.g. Upstash). A single connection-string var, not the
# REST API URL/token pair some other Redis add-ons use.
REDIS_URL=

# ─── HubSpot (Phase 2) ────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# ─── Google Cloud (Search Console + GA4) ───────────────────────
# Service account credentials from Google Cloud Console
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
# Private key as base64-encoded string (to avoid newline parsing issues)
# Encode with: cat private-key.txt | base64 -w 0
GOOGLE_PRIVATE_KEY_BASE64=
# GA4 Property IDs (separate for each product)
SITEMARGIN_GA4_PROPERTY_ID=
FOCABLYED_GA4_PROPERTY_ID=
# Found in GA4 Admin > Property Settings
YFD_GA4_PROPERTY_ID=
